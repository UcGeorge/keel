{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Keel",
  "description": "Deployments your whole team can run. Keel turns the tribal knowledge of how a project deploys into a keel.yaml that anyone can run through a web UI.",
  "colors": {
    "primary": "#0D9488",
    "light": "#2DD4BF",
    "dark": "#0F766E"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://ucgeorge.github.io/keel/"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "install", "quickstart"]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/how-it-works",
              "concepts/deployments-and-environments",
              "concepts/variables",
              "concepts/targets-and-runs",
              "concepts/outputs",
              "concepts/variable-manifests"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/author-a-deployment",
              "guides/environment-images",
              "guides/organize-large-forms",
              "guides/deploy-time-and-conditional-variables",
              "guides/secrets",
              "guides/headless-and-ci",
              "guides/embed-keel-in-a-repository",
              "guides/example-multi-cloud",
              "guides/ai-agents"
            ]
          },
          {
            "group": "Keel Cloud",
            "pages": [
              "cloud/overview",
              "cloud/self-hosting",
              "cloud/deploy-on-google-cloud",
              "cloud/organizations-and-permissions",
              "cloud/connect-repositories",
              "cloud/github-app",
              "cloud/notifications",
              "cloud/ai-insights",
              "cloud/runs-and-security"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "keel.yaml",
            "pages": [
              "reference/keel-yaml",
              "reference/variable-types",
              "reference/validation",
              "reference/conditions",
              "reference/layout",
              "reference/outputs",
              "reference/manifest"
            ]
          },
          {
            "group": "Runtime",
            "pages": [
              "reference/run-environment",
              "reference/cli",
              "reference/keel-cloud-configuration"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/UcGeorge/keel",
          "icon": "github"
        },
        {
          "anchor": "Releases",
          "href": "https://github.com/UcGeorge/keel/releases",
          "icon": "tag"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/UcGeorge/keel"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/UcGeorge/keel"
    }
  },
  "seo": {
    "indexing": "navigable"
  }
}
