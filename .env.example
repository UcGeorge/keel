# Keel Cloud configuration. Copy to .env for docker compose, or export in
# the environment of the keel-cloud process.

# PostgreSQL connection (required outside docker compose).
KEEL_DATABASE_URL=postgres://keel:keel@localhost:5432/keel?sslmode=disable

# Listen address.
KEEL_ADDR=:8080

# External URL of this Keel Cloud — used in invite links and to decide on
# Secure cookies (https => secure).
KEEL_BASE_URL=http://localhost:8080

# Directory for repository clones and run workspaces.
KEEL_DATA_DIR=./keel-data

# 64-char hex AES-256 key encrypting variable values and repo tokens at
# rest. Generate one with:  openssl rand -hex 32
# When unset, a key is generated into KEEL_DATA_DIR (fine for evaluation).
KEEL_ENCRYPTION_KEY=

# --- Optional GitHub App integration ----------------------------------------
# Enables the repository picker and push-triggered deployments.
# Create a GitHub App with permissions: Contents (read), Metadata (read);
# webhook events: push, installation, installation repositories; webhook
# URL: $KEEL_BASE_URL/webhooks/github.
KEEL_GITHUB_APP_ID=
KEEL_GITHUB_APP_SLUG=
# The app's private key: either inline PEM…
KEEL_GITHUB_PRIVATE_KEY=
# …or a path to the .pem file.
KEEL_GITHUB_PRIVATE_KEY_FILE=
KEEL_GITHUB_WEBHOOK_SECRET=
